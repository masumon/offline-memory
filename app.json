{
  "expo": {
    "name": "Offline Memory",
    "slug": "offline-memory",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "offlinememory",
    "icon": "./assets/icon.png",
    "backgroundColor": "#124E78",
    "android": {
      "package": "com.masumon.offlinememory",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#2456C9"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#124E78"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2456C9",
          "defaultChannel": "task-reminders"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Offline Memory uses the microphone only while you hold the mic button, so you can speak a task or memory instead of typing.",
          "speechRecognitionPermission": "Speech is turned into text on this device to capture what you say. Nothing is sent to a server.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAdd",
              "label": "Offline Memory",
              "description": "Quick-add a task or memory",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "app"
      }
    }
  }
}
