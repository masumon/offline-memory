{
  "expo": {
    "name": "Offline Memory",
    "slug": "offline-memory",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "offlinememory",
    "splash": {
      "backgroundColor": "#F4F8F6",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.masumon.offlinememory",
      "permissions": ["SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "backgroundColor": "#006A4E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "app"
      }
    }
  }
}
